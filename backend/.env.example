# ── WhatsApp transport ────────────────────────────────────────────
# greenapi = Green API gateway, linked-device protocol (DEMO — see GREENAPI.md)
# meta     = WhatsApp Cloud API (production path, needs Meta verification)
# mock     = console logs only. Empty = auto-detect from credentials below.
WHATSAPP_PROVIDER=

# ── Green API (console.green-api.com → free Developer instance) ───
GREEN_API_BASE_URL=https://api.green-api.com
GREEN_API_INSTANCE_ID=
GREEN_API_API_TOKEN=
GREEN_API_POLL_MS=3000

# ── WhatsApp Cloud API (test number) ─────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=kolo-verify

# ── AI provider (OpenAI-compatible: gemini | groq | openai | openrouter) ──
# Gemini FREE tier recommended — key at https://aistudio.google.com/apikey
AI_PROVIDER=gemini
AI_API_KEY=
# AI_CHAT_MODEL=     # defaults: gemini-3.5-flash | llama-3.3-70b-versatile | gpt-4o
#                      (Gemini fallback under load: gemini-flash-lite-latest)
# AI_VISION_MODEL=
# AI_AUDIO_MODEL=
# AI_BASE_URL=       # only for custom/self-hosted endpoints
# Legacy OpenAI (used only if AI_API_KEY is empty):
OPENAI_API_KEY=

# ── Paystack (TEST keys) ─────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx

# ── Database ─────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/kolo

# ── Solana (fill during prep, after anchor deploy) ───────────────
SOLANA_RPC_URL=https://api.devnet.solana.com
ESCROW_PROGRAM_ID=
USDC_MINT=
PLATFORM_FEE_WALLET=

# ── App ──────────────────────────────────────────────────────────
PORT=4000
# PUBLIC_BASE_URL is the WEB app URL (checkout links point to /pay/<slug> there)
PUBLIC_BASE_URL=https://your-web-app.vercel.app
USE_STAGE_MOCKS=false

# ── Demo vendor (used by `npm run seed`) ─────────────────────────
DEMO_VENDOR_PHONE=2348000000000
DEMO_VENDOR_NAME=Ada Thrift Store
DEMO_VENDOR_BANK_CODE=058
DEMO_VENDOR_ACCOUNT_NUMBER=0123456789
DEMO_VENDOR_SOLANA_WALLET=
