# ── WhatsApp Cloud API (test number) ─────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=kolo-verify

# ── OpenAI (chat + vision + whisper) ─────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o

# ── Paystack (TEST keys) ─────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx

# ── Database ─────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/kolo

# ── Solana (fill during prep, after anchor deploy) ───────────────
SOLANA_RPC_URL=https://api.devnet.solana.com
ESCROW_PROGRAM_ID=
USDC_MINT=
PLATFORM_FEE_WALLET=

# ── App ──────────────────────────────────────────────────────────
PORT=4000
# PUBLIC_BASE_URL is the WEB app URL (checkout links point to /pay/<slug> there)
PUBLIC_BASE_URL=https://your-web-app.vercel.app
USE_STAGE_MOCKS=false

# ── Demo vendor (used by `npm run seed`) ─────────────────────────
DEMO_VENDOR_PHONE=2348000000000
DEMO_VENDOR_NAME=Ada Thrift Store
DEMO_VENDOR_BANK_CODE=058
DEMO_VENDOR_ACCOUNT_NUMBER=0123456789
DEMO_VENDOR_SOLANA_WALLET=
